    "load_mutation_reference": false
  },
  {
    "name": "api bulk report",
    "request": "Export a structured 90-day campaign report using my configured API client",
    "available": ["python", "api-auth"],
    "expected_mode": "api",
    "expected_write_state": "read-only",
    "load_mutation_reference": false
  },
  {
    "name": "recommendation is not mutation approval",
    "request": "What campaigns should I pause?",
    "available": ["attached-browser"],
    "expected_mode": "browser",
    "expected_write_state": "read-only",
    "load_mutation_reference": false
  },
  {
    "name": "explicit mutation still needs exact preview approval",
    "request": "Pause the campaigns we discussed",
    "available": ["api-auth"],
    "expected_mode": "api",
    "expected_write_state": "preview-and-action-time-approval",
    "load_mutation_reference": true
  },
  {
    "name": "large mutation is independently bounded",
    "request": "Pause these 63 exact keyword entities",
    "available": ["api-auth"],
    "expected_mode": "api",
    "expected_write_state": "independently-previewed-and-approved-batches",
    "requested_entities": 63,
    "maximum_batch_size": 25,
    "expected_batch_sizes": [25, 25, 13],
    "verify_after_each_batch": true,
    "stop_on_failure_or_drift": true,
    "load_mutation_reference": true
  }
